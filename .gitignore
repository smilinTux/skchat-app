# Workspace member build artifacts (root /build/ only covers the app package).
packages/*/build/
packages/*/.dart_tool/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/build/

# PQC Q5 — noble bundle build deps (the bundled web/sk_pqc_noble.js is vendored)
web/pqc/node_modules/
web/pqc/package-lock.json
# PQC Q5 — Dart-emitted interop vector (regenerated by the codec test)
test/pqc_vectors/dart_sealed.json

# Claude Code local worktrees/config
.claude/
